<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="okno.MainWindow"
        Title="Warsztat Programistyczny"
        Width="600" Height="400"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">
    <Border Margin="24"
            Padding="24"
            Background="#181825"
            CornerRadius="16"
            BorderBrush="#313244"
            BorderThickness="2"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
            <TextBlock Text="Warsztat"
                       FontSize="48"
                       FontWeight="Bold"
                       Foreground="#CDD6F4"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="SubtitleText"
                       Text="Aplikacja Avalonia UI"
                       FontSize="18"
                       Foreground="#A6ADC8"
                       HorizontalAlignment="Center" />
            <TextBox x:Name="InputBox"
                     Watermark="Wpisz swoje imię..."
                     Width="260"
                     HorizontalAlignment="Center"
                     Background="#313244"
                     Foreground="#CDD6F4"
                     CornerRadius="6" />
            <Button x:Name="ActionButton"
                    Content="Kliknij mnie"
                    Click="OnButtonClick"
                    HorizontalAlignment="Center"
                    Background="#89B4FA"
                    Foreground="#11111B"
                    FontWeight="SemiBold"
                    Padding="20,10"
                    CornerRadius="8" />
            <ProgressBar x:Name="ProgressBar"
                         Value="70"
                         Minimum="0"
                         Maximum="100"
                         Width="260"
                         Height="8"
                         Foreground="#A6E3A1"
                         Background="#313244"
                         CornerRadius="4"
                         HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
